# Safe to expose to the browser; protected by Supabase RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. This is not needed for the MVP frontend and must never be prefixed NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

# Vercel Blob read/write token for server-side learning material uploads.
BLOB_READ_WRITE_TOKEN=
